# ─────────────────────────────────────────────────────────────────
#  AI投資ファンド (kessho-lens) — 環境変数設定ファイル
#  このファイルを .env にコピーして編集してください
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── AI API ───────────────────────────────────────────────────────
# Anthropic Claude API（必須: AIエージェントの思考・会議生成に使用）
# 取得先: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Alpha Vantage（オプション: リアルタイム株価データ）
# 取得先: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub（オプション: 追加の市場データソース）
# 取得先: https://finnhub.io/register
FINNHUB_API_KEY=

# ── セキュリティ ──────────────────────────────────────────────────
# Cronジョブ保護用シークレット（必須: 本番環境）
# 生成方法: openssl rand -hex 32
CRON_SECRET=your-secret-here

# ── データベース（オプション: Supabase拡張時） ─────────────────────
# Supabase URL と API キー
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── フロントエンド設定 ─────────────────────────────────────────────
# バックエンドAPIのベースURL
# ローカル開発: http://localhost:8000
# 本番: https://your-backend.railway.app または https://your-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── バックエンド設定 ───────────────────────────────────────────────
# サーバーポート（デフォルト: 8000）
PORT=8000

# 環境（development / production）
ENVIRONMENT=development

# CORS許可オリジン（カンマ区切り）
# 例: https://your-frontend.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── データ保存パス ──────────────────────────────────────────────────
# JSONデータファイルのディレクトリ（デフォルト: ../data）
DATA_DIR=../data
