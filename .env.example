# ─────────────────────────────────────────────────────────────────
#  AI投資ファンド (kessho-lens) — 環境変数設定ファイル
#  このファイルを .env にコピーして編集してください
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── AI API ───────────────────────────────────────────────────────
# Anthropic Claude API（必須: AIエージェントの思考・会議生成に使用）
# 取得先: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ── 株価データソース（推奨順） ────────────────────────────────────
# 【推奨】Alpaca Markets - 無料・最高信頼性・1リクエストで全銘柄取得
#   1. https://alpaca.markets/ でアカウント作成（メールのみ・無料）
#   2. ログイン後、左メニューの「Paper Trading」を選択
#   3. 右上「Generate New Key」で API Key ID と Secret Key を取得
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Finnhub（フォールバック: 60req/分・無料）
# 取得先: https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage（最終フォールバック: SPYのみ・25req/日）
# 取得先: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── セキュリティ ──────────────────────────────────────────────────
# Cronジョブ保護用シークレット（必須: 本番環境）
# 生成方法: openssl rand -hex 32
CRON_SECRET=your-secret-here

# ── データベース（オプション: Supabase拡張時） ─────────────────────
# Supabase URL と API キー
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Notion 連携（Tsuburaya Intelligence Brief） ─────────────────────
# 取得手順:
#   1. https://www.notion.so/my-integrations で Internal Integration を作成し
#      Internal Integration Token を NOTION_API_KEY に設定
#   2. Notion で IntelCards DB の親ページを開き、右上 ⋯ → Connections から
#      上記 Integration を招待
#   3. アプリ画面 /intel/notion から「DB作成」を実行し、生成された
#      database_id を NOTION_CARDS_DB_ID に設定
#   4. バックエンドを再起動
NOTION_API_KEY=
NOTION_CARDS_DB_ID=

# ── フロントエンド設定 ─────────────────────────────────────────────
# バックエンドAPIのベースURL
# ローカル開発: http://localhost:8000
# 本番: https://your-backend.railway.app または https://your-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── バックエンド設定 ───────────────────────────────────────────────
# サーバーポート（デフォルト: 8000）
PORT=8000

# 環境（development / production）
ENVIRONMENT=development

# CORS許可オリジン（カンマ区切り）
# 例: https://your-frontend.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── データ保存パス ──────────────────────────────────────────────────
# JSONデータファイルのディレクトリ（デフォルト: ../data）
DATA_DIR=../data
