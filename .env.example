# ─────────────────────────────────────────────────────────────────
#  Tsuburaya Intelligence Brief — 環境変数設定ファイル
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── AI API ───────────────────────────────────────────────────────
# Anthropic Claude API（推奨: カード生成・ブリーフ生成・AI会議に使用）
# 取得先: https://console.anthropic.com/
# 未設定時はテンプレートベースのフォールバックで動作
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ── Notion 連携 ───────────────────────────────────────────────────
# 取得手順:
#   1. https://www.notion.so/my-integrations で Internal Integration を作成し
#      Internal Integration Token を NOTION_API_KEY に設定
#   2. Notion で IntelCards DB の親ページを開き、右上 ⋯ → Connections から
#      上記 Integration を招待
#   3. アプリ画面 /intel/notion から「DB作成」を実行し、生成された
#      database_id を NOTION_CARDS_DB_ID に設定
#   4. バックエンドを再起動
NOTION_API_KEY=
NOTION_CARDS_DB_ID=

# ── メール配信 (Daily Brief Auto Delivery) ────────────────────────
# Resend (推奨: https://resend.com/ — 無料3000通/月、独自ドメイン対応)
# API キー取得: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# 差出人 (Resend で認証済みの送信ドメイン or onresend.dev)
# 例: "Tsuburaya Intel <intel@example.com>"
BRIEF_EMAIL_FROM=

# 配信先 (カンマ区切り)
BRIEF_EMAIL_RECIPIENTS=

# Brief 生成・配信のタイムゾーン (既定: Asia/Tokyo)
BRIEF_TIMEZONE=Asia/Tokyo

# ── ニュース自動取得 (Auto News Ingestion) ───────────────────────
# 日次クロン時に Google News RSS から円谷の関心領域ニュースを自動取得し、
# Claude で IntelCard 化する。APIキー不要（Google News RSS のみ使用）。
# INTEL_AUTO_INGEST=0 で無効化（手動カード入力のみに戻す）。既定: 有効
INTEL_AUTO_INGEST=1
# 1回の取得で生成するカードの上限（Claude 呼び出しコスト管理）。既定: 8
INTEL_NEWS_MAX_ITEMS=8
# 1クエリあたりの取得件数。既定: 3
INTEL_NEWS_PER_QUERY=3
# 検索クエリ（カンマ区切り）。未設定時は円谷向けの既定クエリを使用。
# 例: INTEL_NEWS_QUERIES=ウルトラマン IP,特撮 海外,キャラクター ライセンス
INTEL_NEWS_QUERIES=

# ── クロン認証 ────────────────────────────────────────────────────
# /api/intel/cron/daily-brief を保護する共有シークレット
# 本番では Vercel/Render の環境変数にも同じ値を設定する
# 生成: openssl rand -hex 32
CRON_SECRET=your-secret-here

# ── フロントエンド設定 ─────────────────────────────────────────────
# バックエンドAPIのベースURL
# ローカル開発: http://localhost:8000
# 本番: https://your-backend.onrender.com など
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── バックエンド設定 ───────────────────────────────────────────────
PORT=8000
ENV=development

# CORS許可オリジン（カンマ区切り）
# 例: https://your-frontend.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# フロントエンドURL（CORS許可リストに自動追加）
FRONTEND_URL=
