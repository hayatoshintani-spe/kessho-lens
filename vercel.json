{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/_next/(.*)", "dest": "/frontend/_next/$1" },
    { "src": "/api/(.*)", "dest": "/frontend/api/$1" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ],
  "crons": [
    {
      "path": "/api/trigger-daily",
      "schedule": "0 1 * * *"
    }
  ]
}
