{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/frontend" },
    { "source": "/:path*", "destination": "/frontend/:path*" }
  ],
  "crons": [
    {
      "path": "/api/trigger-daily",
      "schedule": "0 1 * * *"
    }
  ]
}
